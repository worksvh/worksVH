{
    "name": "vhworks/web",
    "description": "Web a jednoduché CMS pro VH Works",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo_sqlite": "*",
        "ext-fileinfo": "*",
        "ext-dom": "*",
