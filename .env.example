# Adresa webu bez lomítka na konci (používá se pro canonical, sitemap a odkazy v e-mailech)
APP_URL=http://localhost:8000
# development | production (production zapne HSTS a Secure cookie)
APP_ENV=development

# SMTP pro odesílání poptávek. Když SMTP_HOST chybí, e-maily se jen uloží do storage/logs/mail/.
# Hodnoty jde přepsat i v administraci (Nastavení › E-mail a SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Kam chodí poptávky (výchozí hodnota, v adminu jde změnit)
INQUIRY_TO=

# Databáze Turso (libSQL). Prázdné = lokální SQLite storage/database.sqlite.
TURSO_URL=
TURSO_TOKEN=
# Jak dlouho (s) se obsah webu čte z lokální kopie, než se ověří změny v Turso. Zápisy z adminu kopii obnoví hned.
TURSO_MIRROR_TTL=300
# E-maily přes Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=API klíč,
# SMTP_FROM=adresa na doméně ověřené v Resendu.
