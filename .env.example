# Adresa webu bez lomítka na konci (canonical, sitemap, odkazy v e-mailech)
APP_URL=http://localhost:3000
# Tajný klíč pro podpis přihlášení: dlouhý náhodný řetězec (openssl rand -hex 32)
APP_KEY=

# Databáze Turso (libSQL). Lokálně jde i soubor: file:storage/local.db
TURSO_URL=
TURSO_TOKEN=

# E-maily přes Resend. Bez klíče nebo odesílatele se e-maily jen uloží do storage/logs/mail/.
RESEND_API_KEY=
# Odesílatel, musí být na doméně ověřené v Resendu, např. web@vhworks.cz (jde přepsat v Nastavení › E-mail)
MAIL_FROM=
# Kam chodí poptávky, když není vyplněno v administraci
INQUIRY_TO=

# Vercel Blob (fotky a přílohy poptávek). Bez tokenu se soubory ukládají lokálně do public/media a storage/.
BLOB_READ_WRITE_TOKEN=
# Tajemství pro Vercel Cron (denní údržba /api/cron)
CRON_SECRET=
