# VH Works – Apache
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # HTTPS na produkci (odkomentujte po nasazení certifikátu)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "^\.|\.(sqlite|env|log|ini)$">
    Require all denied
</FilesMatch>

# Limity pro přílohy poptávek (mod_php). Pro PHP-FPM viz .user.ini
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 55M
    php_value max_file_uploads 10
    php_value max_execution_time 60
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
